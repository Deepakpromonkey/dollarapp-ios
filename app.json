{
  "expo": {
    "name": "DollarTraq",
    "slug": "DollarTraq",
    "owner": "promonkey-dev",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dollartraq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon-ios.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DollarTraq uses your location to show your position on the trip map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "DollarTraq tracks your location in the background to record trip progress.",
        "NSLocationAlwaysUsageDescription": "DollarTraq tracks your location in the background to record trip progress.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ],
        "NSCameraUsageDescription": "DollarTraq uses the camera to capture trip verification photos.",
        "NSPhotoLibraryUsageDescription": "DollarTraq needs access to your photo library to attach trip verification photos.",
        "NSPhotoLibraryAddUsageDescription": "DollarTraq needs permission to save photos to your library.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "DollarTraq uses Face ID to confirm it is you when verifying your driver identity."
      },
      "bundleIdentifier": "com.DollarTraq",
      "supportsTablet": false,
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/icon.png",
        "backgroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBLT59iIMFtBUcjw3U1zufkM3TT2Gbmf9M"
        }
      },
      "package": "com.DollarTraq"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-task-manager",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "DollarTraq needs access to your photo library to attach trip verification photos.",
          "cameraPermission": "DollarTraq uses the camera to capture trip verification photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "DollarTraq uses the camera to capture trip verification photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "DollarTraq needs location access to track your trip in background.",
          "locationAlwaysPermission": "DollarTraq tracks your location in the background to record trip progress.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBLT59iIMFtBUcjw3U1zufkM3TT2Gbmf9M"
        }
      ],
      [
        "@didit-protocol/sdk-react-native",
        {
          "iosVariant": "autodetection"
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "development",
          "iPhoneDeploymentTarget": "16.4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d6721e04-7229-4e5a-84a6-55ede803b5df"
      }
    }
  }
}
